   2. PERSISTENCE  — per-user namespaced, with in-memory fallback
   ============================================================ */
const mem = new Map(); // fallback when window.storage is unavailable
const hasStore = typeof window !== "undefined" && window.storage;

async function rawGet(key, fallback) {
  if (hasStore) {
    try { const r = await window.storage.get(key); return r ? JSON.parse(r.value) : fallback; }
    catch { /* fall through to mem */ }
  }
  return mem.has(key) ? mem.get(key) : fallback;
}
async function rawSet(key, value) {
  mem.set(key, value);
  if (hasStore) { try { await window.storage.set(key, JSON.stringify(value)); } catch {} }
}
async function rawDel(key) {
  mem.delete(key);
  if (hasStore) { try { await window.storage.delete(key); } catch {} }
}

const SESSION_KEY = "curare:session"; // global — identifies the active account
function uidOf(user) {
  const base = (user?.email || user?.name || "anon").toLowerCase().trim();
  return base.replace(/[^a-z0-9]+/g, "-").replace(/^-+|-+$/g, "") || "anon";
}
// Scoped store bound to one user. All workspace data lives under this prefix.
function makeDB(user) {
  const ns = `curare:u:${uidOf(user)}:`;
  return {
    get: (k, fallback) => rawGet(ns + k, fallback),
    set: (k, value) => rawSet(ns + k, value),
    del: (k) => rawDel(ns + k),
  };
}
const DBContext = createContext(null);
const useDB = () => useContext(DBContext);

const K = {
  bookmarks: "bookmarks", chat: "chat", graph: "graph",
  recent: "recent", prefs: "prefs", route: "last-route",
};
const DEFAULT_PREFS = { theme: "light", newEvidence: true, weeklyDigest: false };

function useAuth() {
  const [state, setState] = useState({ status: "checking", user: null });
  useEffect(() => {
    (async () => {
      const sess = await rawGet(SESSION_KEY, null);
      setState(sess ? { status: "in", user: sess } : { status: "guest", user: null });
    })();
  }, []);
  const login = useCallback(async (user) => {
    await rawSet(SESSION_KEY, user);
    setState({ status: "in", user });
  }, []);
  const logout = useCallback(async () => {
    await rawDel(SESSION_KEY);
    setState({ status: "guest", user: null });
  }, []);
  return { ...state, login, logout };
}

function useRecentActivity(db) {
  const [items, setItems] = useState([]);
  useEffect(() => { (async () => setItems(await db.get(K.recent, [])))(); }, [db]);
  const log = useCallback((label, meta) => {
    setItems((prev) => {
      const next = [{ label, meta, ts: Date.now() }, ...prev].slice(0, 8);
      db.set(K.recent, next);
      return next;
    });
  }, [db]);
  return { items, log };
}

