// Quiet, meaningful hero: the real 5-lane convergence motif, not a random spiral.
function ConvergenceMotif() {
  const lanes = ["culture", "species", "compound", "target", "disease"];
  const cols = lanes.map((t, i) => ({ t, x: 60 + i * 95, c: T[t].c }));
  const dots = useMemo(() => cols.flatMap((col, ci) =>
    Array.from({ length: 5 }, (_, ri) => ({
      x: col.x + (((ci * 7 + ri * 13) % 5) - 2) * 5,
      y: 90 + ri * 74 + (((ci + ri) % 3) - 1) * 8,
      r: ri === 2 ? 6 : 4, c: col.c, key: ci + "-" + ri,
    }))), []);
  const curves = useMemo(() => {
    const out = [];
    for (let ci = 0; ci < cols.length - 1; ci++) {
      for (let k = 0; k < 4; k++) {
        const a = dots[ci * 5 + ((k * 2) % 5)], b = dots[(ci + 1) * 5 + ((k * 3 + 1) % 5)];
        out.push({ a, b, key: ci + "c" + k });
      }
    }
    return out;
  }, [dots]);
  return (
    <svg viewBox="0 0 500 470" width="100%" height="100%" preserveAspectRatio="xMidYMid slice" style={{ opacity: 0.9 }}>
      {curves.map(({ a, b, key }) => {
        const mx = (a.x + b.x) / 2;
        return <path key={key} d={`M${a.x} ${a.y} C ${mx} ${a.y}, ${mx} ${b.y}, ${b.x} ${b.y}`}
          fill="none" stroke="rgba(255,255,255,.16)" strokeWidth="1" />;
      })}
      {dots.map((d) => (
        <circle key={d.key} cx={d.x} cy={d.y} r={d.r} fill={d.c} opacity={0.92}
          stroke="rgba(255,255,255,.18)" strokeWidth="1" />
      ))}
    </svg>
  );
}

