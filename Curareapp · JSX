          <div>
            <div className="disp" style={{ fontSize: 14.5, fontWeight: 600 }}>Research assistant</div>
            <div style={{ fontSize: 11, color: "var(--ink3)", display: "flex", alignItems: "center", gap: 5 }}><ShieldCheck size={11} color="var(--accent2)" /> Grounded in the Curare graph · {EVIDENCE.length} sources</div>
          </div>
        </div>
        {!empty && <button className="btn btn-sm btn-ghost" onClick={clear}><RotateCcw size={13} /> New thread</button>}
      </div>

      <div ref={scrollRef} className="scroll" style={{ flex: 1, padding: "26px 24px", display: "flex", flexDirection: "column", gap: 22 }}>
        {empty ? (
          <div style={{ flex: 1, display: "flex", flexDirection: "column", alignItems: "center", justifyContent: "center", gap: 22, textAlign: "center" }}>
            <div style={{ width: 56, height: 56, borderRadius: 17, background: "linear-gradient(135deg,#6D5BD0,#16A39A)", display: "grid", placeItems: "center" }}><Microscope size={27} color="#fff" /></div>
            <div>
              <div className="disp" style={{ fontSize: 21, fontWeight: 600, marginBottom: 8 }}>Ask the discovery engine</div>
              <p style={{ color: "var(--ink3)", fontSize: 14, maxWidth: 420, lineHeight: 1.65 }}>Question any hypothesis, compound, target or tradition. Answers cite evidence from the graph and flag predictions.</p>
            </div>
            <div style={{ display: "grid", gridTemplateColumns: "1fr 1fr", gap: 10, maxWidth: 540, width: "100%" }}>
              {SUGGESTED.map((s) => <button key={s} className="suggested-chip" onClick={() => ask(s)}><Sparkles size={13} color="var(--accent)" style={{ flexShrink: 0 }} /> {s}</button>)}
            </div>
          </div>
        ) : (
          <>
            {msgs.map((m) => m.role === "user" ? (
              <div key={m.id} className="chat-row me">
                <Avatar name={user?.name} size={28} />
                <div className="bubble-me">{m.text}</div>
              </div>
            ) : (
              <div key={m.id} className="chat-row">
                <div className="chat-av" style={{ background: "linear-gradient(135deg,#6D5BD0,#16A39A)" }}><Microscope size={15} color="#fff" /></div>
                <div style={{ minWidth: 0, flex: 1 }}>
                  <div className="bubble-ai"><RichText text={m.text} go={go} /></div>
                  {citedIds(m.text).length > 0 && (
                    <div style={{ marginTop: 12, paddingTop: 12, borderTop: "1px dashed var(--line2)" }}>
                      <div className="eyebrow" style={{ marginBottom: 8 }}>Sources</div>
                      <div style={{ display: "flex", flexDirection: "column", gap: 6 }}>
                        {citedIds(m.text).map((id) => { const e = EV_BY_ID[id]; return (
                          <div key={id} onClick={() => go("evidence")} style={{ display: "flex", gap: 9, alignItems: "center", cursor: "pointer", fontSize: 12.5, color: "var(--ink2)" }}>
                            <span className="cite">{id.split("-")[1]}</span>
                            <span style={{ flex: 1 }}>{e.title} <span className="mono" style={{ color: "var(--ink3)" }}>· {e.authors}, {e.year}</span></span>
                            <SourceBadge q={e.quality} />
                          </div> ); })}
                      </div>
                    </div>
                  )}
                  <button className="btn btn-sm btn-ghost" style={{ marginTop: 8, padding: "4px 8px", fontSize: 11.5, color: "var(--ink3)" }} onClick={() => copy(m)}>
                    {copied === m.id ? <><Check size={12} /> Copied</> : <><Copy size={12} /> Copy</>}
                  </button>
                </div>
              </div>
            ))}
            {busy && (
              <div className="chat-row">
                <div className="chat-av" style={{ background: "linear-gradient(135deg,#6D5BD0,#16A39A)" }}><Microscope size={15} color="#fff" /></div>
                <div className="bubble-ai" style={{ display: "flex", alignItems: "center", gap: 9, color: "var(--ink3)" }}><Loader2 size={14} className="spin" /> Reviewing the Curare graph…</div>
              </div>
            )}
            {err && <div style={{ color: "var(--bad)", fontSize: 13, display: "flex", gap: 7, alignItems: "center", paddingLeft: 39 }}><AlertCircle size={14} /> {err}</div>}
            <div ref={bottomRef} />
          </>
        )}
      </div>

      <div style={{ borderTop: "1px solid var(--line)", padding: "12px 24px 16px", background: "var(--surface)", flexShrink: 0 }}>
        {!empty && showSug && (
          <div style={{ display: "flex", gap: 8, flexWrap: "wrap", marginBottom: 10 }}>
            {SUGGESTED.slice(0, 3).map((s) => <button key={s} className="suggested-chip" style={{ padding: "6px 11px", fontSize: 12 }} onClick={() => ask(s)}>{s}</button>)}
          </div>
        )}
        <div style={{ display: "flex", gap: 10, alignItems: "flex-end" }}>
          <div className="field" style={{ flex: 1, padding: "10px 14px" }}>
            <textarea value={input} onChange={(e) => setInput(e.target.value)} onKeyDown={onKey} placeholder="Ask about hypotheses, compounds, traditions…"
              rows={1} style={{ resize: "none", height: 22, maxHeight: 120, lineHeight: 1.5, fontSize: 13.5 }} />
            <span className="kbd" style={{ alignSelf: "flex-end" }}><CornerDownLeft size={11} /></span>
          </div>
          <button className="btn btn-pri" onClick={() => ask(input)} disabled={busy || !input.trim()} style={{ height: 44, width: 44, padding: 0 }}>
            {busy ? <Loader2 size={15} className="spin" /> : <Send size={15} />}
          </button>
        </div>
      </div>
    </div>
  );
}

