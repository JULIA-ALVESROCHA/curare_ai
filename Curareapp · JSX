        {[["newEvidence", "New evidence on saved hypotheses"], ["weeklyDigest", "Weekly convergence digest"]].map(([k, label]) => (
          <div key={k} style={{ display: "flex", justifyContent: "space-between", alignItems: "center", padding: "9px 0" }}>
            <span style={{ fontSize: 13.5 }}>{label}</span>
            <Switch on={!!prefs[k]} onClick={() => setPrefs((p) => ({ ...p, [k]: !p[k] }))} />
          </div>
        ))}
      </div>
      <div className="cu-card" style={{ padding: 20 }}>
        <div className="eyebrow" style={{ marginBottom: 10 }}>Data & privacy</div>
        <p style={{ fontSize: 12.5, color: "var(--ink3)", lineHeight: 1.65, margin: 0 }}>Your saved hypotheses, assistant threads and preferences are stored under your account and restored across sessions. Nothing is shared with other accounts.</p>
      </div>
    </div>
  );
}

/* ============================================================
   8. COMMAND PALETTE
   ============================================================ */
function Palette({ open, onClose, go }) {
  const [q, setQ] = useState("");
  const [active, setActive] = useState(0);
  useEffect(() => { if (open) { setQ(""); setActive(0); } }, [open]);
  if (!open) return null;
  const pages = [
    ["Dashboard", "dashboard", LayoutDashboard], ["Discovery graph", "graph", Waypoints],
    ["Hypotheses", "hypotheses", Sparkles], ["Research assistant", "assistant", Microscope],
    ["Provenance & evidence", "evidence", ShieldCheck], ["Workspace", "workspaces", FolderKanban],
    ["Settings", "settings", Settings],
  ];
  const ql = q.toLowerCase().trim();
  const matchP = pages.filter((p) => p[0].toLowerCase().includes(ql));
  const matchN = NODES.filter((n) => n.name.toLowerCase().includes(ql)).slice(0, 6);
  const flat = [
    ...matchP.map((p) => ({ kind: "page", key: p[1], label: p[0], Icon: p[2] })),
    ...matchN.map((n) => ({ kind: "node", key: n.id, label: n.name, t: n.t })),
  ];
  const run = (it) => {
    if (!it) return;
    if (it.kind === "page") go(it.key);
    else { const t = nodeById[it.key].t; go(t === "compound" ? "compound" : t === "target" ? "target" : "graph", it.key); }
    onClose();
  };
  const onKey = (e) => {
    if (e.key === "ArrowDown") { e.preventDefault(); setActive((a) => Math.min(flat.length - 1, a + 1)); }
    else if (e.key === "ArrowUp") { e.preventDefault(); setActive((a) => Math.max(0, a - 1)); }
    else if (e.key === "Enter") { e.preventDefault(); run(flat[active]); }
  };
  let idx = -1;
  return (
    <div onClick={onClose} style={{ position: "fixed", inset: 0, background: "rgba(15,15,12,.38)", backdropFilter: "blur(3px)", zIndex: 50, display: "grid", placeItems: "start center", paddingTop: "12vh" }}>
      <div onClick={(e) => e.stopPropagation()} className="cu-card fade-in" style={{ width: 580, maxWidth: "92vw", padding: 0, overflow: "hidden", boxShadow: "var(--shadow-lg)" }}>
        <div style={{ display: "flex", alignItems: "center", gap: 12, padding: "15px 18px", borderBottom: "1px solid var(--line)" }}>
          <Command size={17} color="var(--ink3)" />
          <input autoFocus className="bare" placeholder="Search nodes and pages…" value={q} onChange={(e) => { setQ(e.target.value); setActive(0); }} onKeyDown={onKey} />
          <span className="kbd">ESC</span>
        </div>
        <div className="scroll" style={{ maxHeight: 366, padding: 8 }}>
          {matchP.length > 0 && <div className="eyebrow" style={{ padding: "8px 12px 4px" }}>Pages</div>}
          {matchP.map((p) => { idx++; const i = idx; const Icon = p[2]; return (
            <div key={p[1]} className={"navitem" + (active === i ? " on" : "")} onMouseEnter={() => setActive(i)} onClick={() => run({ kind: "page", key: p[1] })}>
              <Icon size={14} color="var(--ink3)" /> {p[0]}
            </div>); })}
          {matchN.length > 0 && <div className="eyebrow" style={{ padding: "10px 12px 4px" }}>Nodes</div>}
          {matchN.map((n) => { idx++; const i = idx; return (
            <div key={n.id} className={"navitem" + (active === i ? " on" : "")} onMouseEnter={() => setActive(i)} onClick={() => run({ kind: "node", key: n.id })}>
              <span style={{ width: 9, height: 9, borderRadius: 9, background: T[n.t].c, flexShrink: 0 }} />
              <span style={{ flex: 1, minWidth: 0, overflow: "hidden", textOverflow: "ellipsis", whiteSpace: "nowrap" }}>{n.name}</span>
              <span className="mono" style={{ fontSize: 10, color: "var(--ink3)", textTransform: "uppercase" }}>{T[n.t].label}</span>
            </div>); })}
          {flat.length === 0 && <div style={{ padding: 22, textAlign: "center", color: "var(--ink3)", fontSize: 13 }}>No matches for “{q}”</div>}
        </div>
      </div>
    </div>
  );
}

/* ============================================================
   9. NAVIGATION + APP SHELL
   ============================================================ */
const NAV = [
  ["dashboard", "Dashboard", LayoutDashboard],
  ["graph", "Discovery graph", Waypoints],
  ["hypotheses", "Hypotheses", Sparkles],
  ["assistant", "Research assistant", Microscope],
  ["evidence", "Provenance", ShieldCheck],
];
const NAV_WS = [
  ["workspaces", "Workspace", FolderKanban],
  ["settings", "Settings", Settings],
];
const CRUMBS = {
  dashboard: ["Dashboard"], graph: ["Discovery graph"], hypotheses: ["Hypotheses"],
  hypothesis: ["Hypotheses", "Detail"], assistant: ["Research assistant"],
  evidence: ["Provenance & evidence"], compound: ["Compounds", "Dossier"],
  target: ["Targets", "Dossier"], workspaces: ["Workspace"], settings: ["Settings"],
};

function Shell({ user, logout }) {
  const db = useMemo(() => makeDB(user), [user]);
  const shellRef = useRef(null);
  const loadedRef = useRef(false);
  const [route, setRoute] = useState(null);
  const [pal, setPal] = useState(false);
  const [sidebarOpen, setSidebarOpen] = useState(false);
  const [bookmarks, setBookmarks] = useState([]);
  const [prefs, setPrefs] = useState(DEFAULT_PREFS);
  const [graphInitial, setGraphInitial] = useState(undefined);
  const { items: recent, log } = useRecentActivity(db);

  // restore per-user workspace state on mount / account switch
  useEffect(() => {
    let alive = true;
    loadedRef.current = false;
    (async () => {
      const [lastRoute, bm, pf, gs] = await Promise.all([
        db.get(K.route, { name: "dashboard", id: null }),
        db.get(K.bookmarks, []),
        db.get(K.prefs, DEFAULT_PREFS),
        db.get(K.graph, undefined),
      ]);
      if (!alive) return;
      setBookmarks(bm); setPrefs({ ...DEFAULT_PREFS, ...pf }); setGraphInitial(gs);
      setRoute(lastRoute);
      loadedRef.current = true;
    })();
    return () => { alive = false; };
  }, [db]);

  // apply theme to the root element (cascades to all surfaces + portals)
  useEffect(() => {
    const root = shellRef.current?.closest(".cu-root");
    if (root) root.setAttribute("data-theme", prefs.theme || "light");
  }, [prefs.theme]);

  const go = useCallback((name, id = null) => {
    setRoute({ name, id }); setSidebarOpen(false);
    db.set(K.route, { name, id });
    if (name === "compound" || name === "target") log("Opened dossier", id && nodeById[id]?.name);
    if (name === "hypothesis") log("Opened hypothesis", id && HYPOTHESES.find((h) => h.id === id)?.title?.slice(0, 40));
  }, [db, log]);

  useEffect(() => {
    const h = (e) => {
      if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === "k") { e.preventDefault(); setPal((p) => !p); }
      if (e.key === "Escape") { setPal(false); setSidebarOpen(false); }
    };
    window.addEventListener("keydown", h); return () => window.removeEventListener("keydown", h);
  }, []);

  // persist prefs (only after initial restore, so we never clobber stored prefs)
  useEffect(() => { if (loadedRef.current) db.set(K.prefs, prefs); }, [db, prefs]);

  const toggleBookmark = useCallback((id) => {
    setBookmarks((prev) => {
      const next = prev.includes(id) ? prev.filter((x) => x !== id) : [...prev, id];
      db.set(K.bookmarks, next);
      return next;
    });
  }, [db]);

  if (!route) {
    return <div ref={shellRef} style={{ height: "100vh", display: "grid", placeItems: "center", background: "var(--bg)" }}><Loader2 className="spin" color="var(--accent)" /></div>;
  }

  const crumbs = CRUMBS[route.name] || ["Curare"];
  const navOn = (k) => route.name === k
    || (k === "hypotheses" && route.name === "hypothesis")
    || (k === "graph" && (route.name === "compound" || route.name === "target"))
    || (k === "evidence" && route.name === "evidence");

  return (
    <DBContext.Provider value={db}>
      <div className="cu-shell" ref={shellRef}>
        {sidebarOpen && <div className="drawer-scrim open" onClick={() => setSidebarOpen(false)} />}
        <aside className={"cu-sidebar" + (sidebarOpen ? " open" : "")}>
          <div style={{ display: "flex", alignItems: "center", justifyContent: "space-between", padding: "4px 6px 18px" }}>
            <div style={{ display: "flex", alignItems: "center", gap: 10 }}>
              <div style={{ width: 32, height: 32, borderRadius: 10, background: "linear-gradient(135deg,#6D5BD0,#16A39A)", display: "grid", placeItems: "center", flexShrink: 0 }}>
                <Atom size={18} color="#fff" />
              </div>
              <div>
                <div className="disp" style={{ fontWeight: 600, fontSize: 15, lineHeight: 1, color: "var(--side-ink-bright)" }}>Curare<span style={{ color: "#9C8CF0" }}>.AI</span></div>
                <div className="mono" style={{ fontSize: 9, color: "var(--side-ink-dim)", marginTop: 3, letterSpacing: ".06em" }}>HYPOTHESIS ENGINE</div>
              </div>
            </div>
            <button className="iconbtn menubtn" style={{ background: "transparent", border: "none", color: "var(--side-ink)", width: 28, height: 28 }} onClick={() => setSidebarOpen(false)}><X size={15} /></button>
          </div>

          <button onClick={() => setPal(true)} style={{ display: "flex", alignItems: "center", gap: 8, padding: "9px 12px", marginBottom: 16, cursor: "pointer", color: "var(--side-ink-dim)", fontSize: 12.5, width: "100%", fontFamily: "inherit", background: "rgba(255,255,255,.06)", border: "1px solid var(--side-line)", borderRadius: "var(--r-sm)" }}>
            <Search size={14} /> Search… <span className="kbd" style={{ marginLeft: "auto", background: "rgba(255,255,255,.08)", border: "1px solid rgba(255,255,255,.12)", color: "var(--side-ink-dim)" }}>⌘K</span>
          </button>

          <nav style={{ display: "flex", flexDirection: "column", gap: 2 }}>
            {NAV.map(([k, label, Icon]) => (
              <div key={k} className={"s-navitem" + (navOn(k) ? " on" : "")} onClick={() => go(k)}><Icon size={16} /> {label}</div>
            ))}
            <div style={{ margin: "12px 6px", height: 1, background: "var(--side-line)" }} />
            <div className="eyebrow on-dark" style={{ padding: "2px 11px 8px" }}>Workspace</div>
            {NAV_WS.map(([k, label, Icon]) => (
              <div key={k} className={"s-navitem" + (route.name === k ? " on" : "")} onClick={() => go(k)}><Icon size={16} /> {label}</div>
            ))}
          </nav>

          <div style={{ marginTop: "auto", paddingTop: 12 }}>
            <div className="s-navitem" style={{ padding: 10, gap: 10 }} onClick={() => go("settings")}>
              <Avatar name={user?.name} size={30} />
              <div style={{ minWidth: 0, flex: 1 }}>
                <div style={{ fontSize: 12.5, fontWeight: 600, color: "var(--side-ink-bright)", whiteSpace: "nowrap", overflow: "hidden", textOverflow: "ellipsis" }}>{user?.name}</div>
                <div style={{ fontSize: 10.5, color: "var(--side-ink-dim)" }}>CICSIC 2026 · ICN</div>
              </div>
              <button className="iconbtn" style={{ marginLeft: "auto", background: "transparent", border: "none", color: "var(--side-ink-dim)", width: 26, height: 26 }} onClick={(e) => { e.stopPropagation(); logout(); }} title="Sign out"><LogOut size={13} /></button>
            </div>
          </div>
        </aside>

        <main style={{ display: "flex", flexDirection: "column", height: "100%", overflow: "hidden", background: "var(--bg)" }}>
          <header style={{ display: "flex", alignItems: "center", justifyContent: "space-between", padding: "13px 24px", borderBottom: "1px solid var(--line)", background: "var(--surface)", flexShrink: 0 }}>
            <div style={{ display: "flex", alignItems: "center", gap: 12 }}>
              <button className="iconbtn menubtn" onClick={() => setSidebarOpen(true)}><Menu size={16} /></button>
              <div style={{ display: "flex", alignItems: "center", gap: 7, fontSize: 13, color: "var(--ink3)" }}>
                <Atom size={14} color="var(--accent)" />
                {crumbs.map((c, i) => (
                  <React.Fragment key={i}>
                    {i > 0 && <ChevronRight size={13} />}
                    <span style={{ color: i === crumbs.length - 1 ? "var(--ink)" : "var(--ink3)", fontWeight: i === crumbs.length - 1 ? 600 : 400 }}>{c}</span>
                  </React.Fragment>
                ))}
              </div>
            </div>
            <div style={{ display: "flex", alignItems: "center", gap: 8 }}>
              <button className="iconbtn" onClick={() => setPal(true)} title="Search (⌘K)"><Search size={16} /></button>
              <button className="iconbtn" title="Notifications"><Bell size={16} /></button>
              <div onClick={() => go("settings")} style={{ cursor: "pointer" }}><Avatar name={user?.name} size={32} /></div>
            </div>
          </header>

          <div style={{ flex: 1, minHeight: 0, overflow: "hidden" }}>
            {route.name === "dashboard"  && <DashboardView go={go} user={user} bookmarks={bookmarks} toggleBookmark={toggleBookmark} />}
            {route.name === "graph"      && <GraphView go={go} initial={graphInitial} onPersist={(s) => db.set(K.graph, s)} />}
            {route.name === "hypotheses" && <HypothesesView go={go} bookmarks={bookmarks} toggleBookmark={toggleBookmark} />}
            {route.name === "hypothesis" && <HypothesisDetail id={route.id} go={go} bookmarks={bookmarks} toggleBookmark={toggleBookmark} />}
            {route.name === "assistant"  && <AssistantView go={go} user={user} log={log} />}
            {route.name === "evidence"   && <EvidenceView go={go} />}
            {route.name === "compound"   && <DossierView id={route.id || "cp-quinine"} kind="compound" go={go} />}
            {route.name === "target"     && <DossierView id={route.id || "tg-hemoz"} kind="target" go={go} />}
            {route.name === "workspaces" && <WorkspaceView go={go} bookmarks={bookmarks} toggleBookmark={toggleBookmark} recent={recent} />}
            {route.name === "settings"   && <SettingsView user={user} logout={logout} prefs={prefs} setPrefs={setPrefs} />}
          </div>
        </main>

        <Palette open={pal} onClose={() => setPal(false)} go={go} />
      </div>
    </DBContext.Provider>
  );
}

export default function App() {
  const { status, user, login, logout } = useAuth();
  if (status === "checking") {
    return (
      <div className="cu-root" style={{ height: "100vh", display: "grid", placeItems: "center" }}>
        <style>{CSS}</style>
        <Loader2 size={22} className="spin" color="var(--accent)" />
      </div>
    );
  }
  if (status === "guest") return <LoginScreen onLogin={login} />;
  return (
    <div className="cu-root">
      <style>{CSS}</style>
      <Shell user={user} logout={logout} />
    </div>
  );
}