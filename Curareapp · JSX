const SYS_PROMPT = `You are the Curare.AI research assistant, an expert in ethnopharmacology and natural product drug discovery. You have access to the Curare dataset: 5 cultural traditions (Amazonian, TCM, Andean/Quechua, Tupi, Greek/European), 5 plant species (Chondrodendron tomentosum, Artemisia annua, Cinchona officinalis, Pilocarpus jaborandi, Salix alba), 5 compounds (d-Tubocurarine, Artemisinin, Quinine, Pilocarpine, Salicylates), 5 molecular targets (nAChR, mAChR M3, COX-1/2, Heme/PfATP6, Hemozoin), and 5 diseases (neuromuscular blockade, malaria, glaucoma/xerostomia, inflammation/thrombosis, Alzheimer's). There are 5 hypotheses scored by cultural convergence, phytochemical overlap, target plausibility, and evidence quality. Answer questions based on this dataset. Be scientifically precise, cite evidence IDs like [ev-1] when relevant, keep responses concise (under 150 words), and flag when claims are predicted vs. established.`;

const SUGGESTED = [
  "Why does the malaria hypothesis score 92?",
  "Explain the cholinergic axis hypothesis",
  "What evidence supports artemisinin?",
  "Could pilocarpine help in Alzheimer's?",
];
const EV_BY_ID = Object.fromEntries(EVIDENCE.map((e) => [e.id, e]));

function RichText({ text, go }) {
  const paras = text.split(/\n{2,}/);
  const renderInline = (chunk, kp) => {
    const parts = chunk.split(/(\[ev-\d+\])/g);
    return parts.map((p, i) => {
      const m = p.match(/^\[(ev-\d+)\]$/);
      if (m && EV_BY_ID[m[1]]) {
        const e = EV_BY_ID[m[1]];
        return <span key={kp + "-" + i} className="cite" title={`${e.title} — ${e.authors}, ${e.year}`} onClick={() => go("evidence")}>{m[1].split("-")[1]}</span>;
      }
      return <React.Fragment key={kp + "-" + i}>{p}</React.Fragment>;
    });
  };
  return <>{paras.map((p, i) => <p key={i}>{p.split(/\n/).map((line, j) => <React.Fragment key={j}>{j > 0 && <br />}{renderInline(line, i + "_" + j)}</React.Fragment>)}</p>)}</>;
}

function citedIds(text) { return [...new Set([...text.matchAll(/\[(ev-\d+)\]/g)].map((m) => m[1]))].filter((id) => EV_BY_ID[id]); }

function AssistantView({ go, user, log }) {
  const db = useDB();
  const [msgs, setMsgs] = useState(null);
  const [input, setInput] = useState("");
  const [busy, setBusy] = useState(false);
  const [err, setErr] = useState("");
  const [showSug, setShowSug] = useState(true);
  const [copied, setCopied] = useState(null);
  const bottomRef = useRef();
  const scrollRef = useRef();

  useEffect(() => { (async () => setMsgs(await db.get(K.chat, [])))(); }, [db]);
  useEffect(() => {
    if (msgs !== null) db.set(K.chat, msgs.slice(-20));
    bottomRef.current?.scrollIntoView({ behavior: "smooth" });
  }, [msgs]); // eslint-disable-line

  const ask = useCallback(async (text) => {
    if (!text.trim() || busy) return;
    setMsgs((prev) => [...(prev || []), { role: "user", text, id: Date.now() }]);
    setInput(""); setBusy(true); setErr(""); setShowSug(false);
    log("Asked assistant", text.slice(0, 50));
    try {
      const history = (msgs || []).slice(-8).map((m) => ({ role: m.role === "user" ? "user" : "assistant", content: m.text }));
      const res = await fetch("https://api.anthropic.com/v1/messages", {
        method: "POST", headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ model: "claude-sonnet-4-6", max_tokens: 1000, system: SYS_PROMPT, messages: [...history, { role: "user", content: text }] }),
      });
      const data = await res.json();
      const aiText = data.content?.find((b) => b.type === "text")?.text || "I couldn't form a response from the dataset. Try rephrasing the question.";
      setMsgs((prev) => [...prev, { role: "assistant", text: aiText, id: Date.now() + 1 }]);
    } catch { setErr("Connection error — your question wasn't sent. Try again."); }
    setBusy(false);
  }, [msgs, busy, log]);

  const onKey = (e) => { if (e.key === "Enter" && !e.shiftKey) { e.preventDefault(); ask(input); } };
  const copy = (m) => { navigator.clipboard?.writeText(m.text); setCopied(m.id); setTimeout(() => setCopied(null), 1400); };
  const clear = () => { setMsgs([]); db.del(K.chat); setShowSug(true); };

  if (msgs === null) return <div style={{ height: "100%", display: "grid", placeItems: "center" }}><Loader2 className="spin" color="var(--accent)" /></div>;
  const empty = msgs.length === 0;

  return (
    <div style={{ height: "100%", display: "flex", flexDirection: "column", overflow: "hidden" }}>
      <div style={{ display: "flex", alignItems: "center", justifyContent: "space-between", padding: "14px 24px", borderBottom: "1px solid var(--line)", flexShrink: 0 }}>
        <div style={{ display: "flex", alignItems: "center", gap: 11 }}>
