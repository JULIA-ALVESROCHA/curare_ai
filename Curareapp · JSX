// Real thumbnail of the convergence map (deterministic layered layout).
function MiniMap() {
  const W = 460, H = 300, pad = 34;
  const pos = useMemo(() => {
    const p = {};
    LANES.forEach((t, li) => {
      const ns = NODES.filter((n) => n.t === t);
      ns.forEach((n, ri) => {
        p[n.id] = { x: pad + li * ((W - pad * 2) / 4), y: pad + (ri + 0.5) * ((H - pad * 2) / ns.length), c: T[t].c };
      });
    });
    NODES.filter((n) => n.t === "evidence").forEach((n, ri) => {
      p[n.id] = { x: pad + 2 * ((W - pad * 2) / 4) + ((ri % 2) * 18 - 9), y: H - 16, c: T.evidence.c };
    });
    return p;
  }, []);
  return (
    <svg viewBox={`0 0 ${W} ${H}`} width="100%" height="100%" style={{ display: "block" }}>
      {LANES.map((t, li) => <text key={t} x={pad + li * ((W - pad * 2) / 4)} y={16} textAnchor="middle" style={{ fontSize: 8.5, fontWeight: 700, letterSpacing: ".08em", fill: T[t].c, opacity: 0.7, fontFamily: "var(--font-body)" }}>{T[t].label.toUpperCase()}</text>)}
      {LINKS.map(([a, b, rel], i) => {
        const s = pos[a], t = pos[b]; if (!s || !t) return null;
        const mx = (s.x + t.x) / 2;
        return <path key={i} d={`M${s.x} ${s.y} C ${mx} ${s.y}, ${mx} ${t.y}, ${t.x} ${t.y}`} fill="none"
          stroke={rel === "predicted" ? "var(--accent)" : rel === "evidence" ? "var(--accent2)" : "var(--edge)"}
          strokeWidth={1} opacity={rel === "predicted" ? 0.6 : 0.45} strokeDasharray={rel === "predicted" ? "4 3" : rel === "evidence" ? "1 4" : undefined} />;
      })}
      {Object.values(pos).map((d, i) => (
        <g key={i}><circle cx={d.x} cy={d.y} r={4.5} fill="var(--surface)" /><circle cx={d.x} cy={d.y} r={3.2} fill={d.c} /></g>
      ))}
    </svg>
  );
}

