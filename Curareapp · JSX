/* ============================================================
   6. DISCOVERY GRAPH  — layered convergence map
   ============================================================ */
const LANES = ["culture", "species", "compound", "target", "disease"];
const COL_X = { culture: 0.11, species: 0.30, compound: 0.5, target: 0.70, disease: 0.89, evidence: 0.5 };
const ROW_Y = { culture: 0.30, species: 0.42, compound: 0.5, target: 0.58, disease: 0.70, evidence: 0.9 };
const REL_LABEL = { uses: "uses", contains: "contains", targets: "targets", implicated: "implicated in", predicted: "predicted", evidence: "evidence" };

function useForce(dim) {
  const [, setTick] = useState(0);
  const sim = useRef({ nodes: [], links: [], alpha: 0, dragId: null });
  const dimRef = useRef(dim);
  const running = useRef(false);
  const raf = useRef(0);
  dimRef.current = dim;

  const loop = useCallback(() => {
    const { nodes: ns, links: ls } = sim.current;
    const W = dimRef.current.w, H = dimRef.current.h;
    let alpha = sim.current.alpha;
    if (alpha < 0.004 || !W) { sim.current.alpha = 0; running.current = false; setTick((t) => t + 1); return; }
    alpha *= 0.984;
    ls.forEach(({ source: si, target: ti }) => {
      const s = ns[si], t = ns[ti];
      const dx = t.x - s.x, dy = t.y - s.y;
      const d = Math.sqrt(dx * dx + dy * dy) || 1;
      const f = ((d - 96) / d) * 0.9 * alpha;
      s.vx += dx * f; s.vy += dy * f; t.vx -= dx * f; t.vy -= dy * f;
    });
    for (let i = 0; i < ns.length; i++) {
      for (let j = i + 1; j < ns.length; j++) {
        const dx = ns[j].x - ns[i].x, dy = ns[j].y - ns[i].y;
        const d2 = dx * dx + dy * dy + 1;
        const f = 22 / d2;
        ns[i].vx -= dx * f; ns[i].vy -= dy * f; ns[j].vx += dx * f; ns[j].vy += dy * f;
      }
    }
    ns.forEach((n) => {
      n.vx += (COL_X[n.t] * W - n.x) * 0.085 * alpha;
      n.vy += (ROW_Y[n.t] * H - n.y) * 0.045 * alpha;
    });
    ns.forEach((n) => {
      if (n.id === sim.current.dragId) { n.vx = n.vy = 0; return; }
      n.vx *= 0.82; n.vy *= 0.82;
      n.x = Math.max(26, Math.min(W - 26, n.x + n.vx));
      n.y = Math.max(40, Math.min(H - 30, n.y + n.vy));
    });
    sim.current.alpha = alpha;
    setTick((t) => t + 1);
    raf.current = requestAnimationFrame(loop);
  }, []);

  const kick = useCallback((a = 0.4) => {
    sim.current.alpha = Math.max(sim.current.alpha, a);
    if (!running.current) { running.current = true; raf.current = requestAnimationFrame(loop); }
  }, [loop]);

  useEffect(() => {
    if (!dim.w || !dim.h) return;
    const W = dim.w, H = dim.h;
    const prev = Object.fromEntries(sim.current.nodes.map((n) => [n.id, n]));
    const nodes = NODES.map((n) => {
      const p = prev[n.id];
      return p ? { ...n, x: p.x, y: p.y, vx: 0, vy: 0 }
        : { ...n, x: COL_X[n.t] * W + (Math.random() - 0.5) * 30, y: ROW_Y[n.t] * H + (Math.random() - 0.5) * 60, vx: 0, vy: 0 };
    });
    const idx = Object.fromEntries(nodes.map((n, i) => [n.id, i]));
    const links = LINKS.map(([a, b, rel]) => ({ source: idx[a], target: idx[b], rel }));
    sim.current = { nodes, links, alpha: 1, dragId: null };
    kick(1);
    return () => cancelAnimationFrame(raf.current);
  }, [dim.w, dim.h, kick]);

  return { sim, kick };
}

function curve(s, t, sign) {
  const mx = (s.x + t.x) / 2, my = (s.y + t.y) / 2;
  const dx = t.x - s.x, dy = t.y - s.y;
  const len = Math.sqrt(dx * dx + dy * dy) || 1;
  const off = Math.max(8, Math.min(54, len * 0.16)) * sign;
  const cx = mx + (-dy / len) * off, cy = my + (dx / len) * off;
  return { d: `M${s.x} ${s.y} Q ${cx} ${cy} ${t.x} ${t.y}`, cx, cy };
}

function ForceGraph({ selectedId, onSelect, typeFilter, view, setView }) {
  const ref = useRef();
  const [dim, setDim] = useState({ w: 0, h: 0 });
  const [hoverId, setHoverId] = useState(null);
  const press = useRef(null); // {mode:'pan'|'drag', id, sx, sy, ox, oy, moved}
  const { sim, kick } = useForce(dim);

  useEffect(() => {
    const el = ref.current; if (!el) return;
    const ro = new ResizeObserver(([e]) => setDim({ w: e.contentRect.width, h: e.contentRect.height }));
    ro.observe(el); return () => ro.disconnect();
  }, []);

  const screenToWorld = (cx, cy) => ({ x: (cx - view.x) / view.k, y: (cy - view.y) / view.k });
  const nearestNode = (wx, wy, maxD = 22) => {
    let best = null, bd = maxD * maxD / (view.k * view.k);
    sim.current.nodes.forEach((n) => {
      if (!typeFilter.includes(n.t)) return;
      const d2 = (n.x - wx) ** 2 + (n.y - wy) ** 2;
      if (d2 < bd) { bd = d2; best = n.id; }
    });
    return best;
  };

  // fly to selection
  useEffect(() => {
    if (!selectedId || !dim.w) return;
    const id = requestAnimationFrame(() => {
      const n = sim.current.nodes.find((z) => z.id === selectedId);
      if (!n) return;
      setView((v) => { const k = Math.max(v.k, 1.25); return { k, x: dim.w / 2 - n.x * k, y: dim.h / 2 - n.y * k }; });
    });
    return () => cancelAnimationFrame(id);
  }, [selectedId, dim.w]); // eslint-disable-line

  const onDown = (e) => {
    if (e.button !== 0) return;
    const rect = ref.current.getBoundingClientRect();
    const sx = e.clientX - rect.left, sy = e.clientY - rect.top;
    const wp = screenToWorld(sx, sy);
    const id = nearestNode(wp.x, wp.y);
    if (id) { sim.current.dragId = id; press.current = { mode: "drag", id, sx, sy, moved: 0 }; }
    else press.current = { mode: "pan", ox: view.x - sx, oy: view.y - sy, sx, sy, moved: 0 };
  };
  const onMove = (e) => {
    const rect = ref.current?.getBoundingClientRect(); if (!rect) return;
    const sx = e.clientX - rect.left, sy = e.clientY - rect.top;
    const p = press.current;
    if (p) {
      p.moved += Math.abs(sx - p.sx) + Math.abs(sy - p.sy);
      if (p.mode === "pan") setView((v) => ({ ...v, x: p.ox + sx, y: p.oy + sy }));
      else {
        const wp = screenToWorld(sx, sy);
        const n = sim.current.nodes.find((z) => z.id === p.id);
        if (n) { n.x = wp.x; n.y = wp.y; n.vx = n.vy = 0; kick(0.12); }
      }
      return;
    }
    const wp = screenToWorld(sx, sy);
    const id = nearestNode(wp.x, wp.y, 18);
    if (id !== hoverId) setHoverId(id);
  };
  const onUp = () => {
    const p = press.current; press.current = null; sim.current.dragId = null;
    if (!p) return;
    if (p.moved < 5) { p.mode === "drag" ? onSelect(p.id) : onSelect(null); }
    kick(0.1);
  };
  const onWheel = (e) => {
    e.preventDefault();
    const rect = ref.current.getBoundingClientRect();
    const mx = e.clientX - rect.left, my = e.clientY - rect.top;
    const factor = e.deltaY < 0 ? 1.12 : 0.893;
    setView((v) => { const k = Math.max(0.35, Math.min(3.5, v.k * factor)); return { k, x: mx - (mx - v.x) * (k / v.k), y: my - (my - v.y) * (k / v.k) }; });
  };

  const { nodes, links } = sim.current;
  const active = new Set(typeFilter);
  const focus = selectedId ? reachable(selectedId, 6) : null;
  const visIds = new Set(nodes.filter((n) => active.has(n.t)).map((n) => n.id));
  const neigh = selectedId ? adj[selectedId] : new Set();
  const labelFor = (id) => view.k >= 1.55 || id === selectedId || id === hoverId || neigh.has(id);

  return (
    <svg ref={ref} style={{ position: "absolute", inset: 0, width: "100%", height: "100%", display: "block", cursor: press.current?.mode === "pan" ? "grabbing" : hoverId ? "pointer" : "grab", userSelect: "none", touchAction: "none" }}
      onMouseDown={onDown} onMouseMove={onMove} onMouseUp={onUp} onMouseLeave={() => { onUp(); setHoverId(null); }} onWheel={onWheel}>
      <defs>
        <marker id="ah" markerWidth="7" markerHeight="7" refX="6" refY="3.2" orient="auto"><path d="M0 0 L6.5 3.2 L0 6.4 Z" fill="var(--ink3)" /></marker>
        <marker id="ah-a" markerWidth="7" markerHeight="7" refX="6" refY="3.2" orient="auto"><path d="M0 0 L6.5 3.2 L0 6.4 Z" fill="var(--accent)" /></marker>
      </defs>
      <g transform={`translate(${view.x},${view.y}) scale(${view.k})`}>
        {/* lane bands + headers (world space) */}
        {dim.w > 0 && LANES.filter((t) => active.has(t)).map((t) => {
          const cx = COL_X[t] * dim.w, w = dim.w * 0.158;
          return (
            <g key={t}>
              <rect x={cx - w / 2} y={6} width={w} height={dim.h - 12} rx={16} fill={T[t].c} opacity={0.05} />
              <text x={cx} y={28} textAnchor="middle" style={{ fontSize: 10.5, fontWeight: 700, letterSpacing: ".12em", fill: T[t].c, opacity: 0.8, fontFamily: "var(--font-body)", textTransform: "uppercase" }}>{T[t].label}</text>
            </g>
          );
        })}
        {/* edges */}
        {links.map((l, i) => {
          const s = nodes[l.source], t = nodes[l.target];
          if (!s || !t || !visIds.has(s.id) || !visIds.has(t.id)) return null;
          const inFocus = focus && focus.has(s.id) && focus.has(t.id);
          const faded = focus && !inFocus;
          const sign = i % 2 ? 1 : -1;
          const { d } = curve(s, t, sign);
          let stroke = "var(--edge)", w = 1.3, op = 0.7, dash, marker;
          if (l.rel === "predicted") { stroke = "var(--accent)"; dash = "5 4"; op = 0.75; }
          else if (l.rel === "evidence") { stroke = "var(--accent2)"; dash = "1 5"; w = 1.5; op = 0.7; }
          if (faded) { stroke = "var(--edge-faint)"; op = 1; w = 1; dash = undefined; }
          if (inFocus) { w = l.rel === "evidence" ? 1.8 : 2; op = 0.95; marker = l.rel === "predicted" ? "url(#ah-a)" : "url(#ah)"; }
          return <path key={i} d={d} fill="none" stroke={stroke} strokeWidth={w} opacity={op} strokeDasharray={dash} markerEnd={marker} strokeLinecap="round" />;
        })}
        {/* nodes */}
        {nodes.filter((n) => active.has(n.t)).map((n) => {
          const d = T[n.t];
          const sel = n.id === selectedId, hov = n.id === hoverId;
          const faded = focus && !focus.has(n.id);
          const r = sel ? 12 : hov ? 10 : 7.5;
          return (
            <g key={n.id} opacity={faded ? 0.28 : 1} style={{ transition: "opacity .2s" }}>
              {(sel || hov) && <circle cx={n.x} cy={n.y} r={r + 11} fill={d.c} opacity={0.15} />}
              <circle cx={n.x} cy={n.y} r={r + 2.5} fill="var(--surface)" />
              <circle cx={n.x} cy={n.y} r={r} fill={d.c} stroke={sel ? "var(--surface)" : "transparent"} strokeWidth={sel ? 2.5 : 0} />
              {sel && <circle cx={n.x} cy={n.y} r={r + 4} fill="none" stroke={d.c} strokeWidth={1.5} opacity={0.5} />}
              {!faded && labelFor(n.id) && (() => {
                const txt = n.name.length > 22 ? n.name.slice(0, 21) + "…" : n.name;
                const w = txt.length * 6.0 + 16, ly = n.y + r + 8;
                return (
                  <g style={{ pointerEvents: "none" }}>
                    <rect x={n.x - w / 2} y={ly} width={w} height={19} rx={9.5} fill="var(--surface)" stroke="var(--line)" strokeWidth={1} opacity={0.96} />
                    <text x={n.x} y={ly + 13} textAnchor="middle" style={{ fontSize: 10.5, fontWeight: sel ? 600 : 500, fill: "var(--ink2)", fontFamily: "var(--font-body)" }}>{txt}</text>
                  </g>
                );
              })()}
            </g>
          );
        })}
      </g>
    </svg>
  );
}

